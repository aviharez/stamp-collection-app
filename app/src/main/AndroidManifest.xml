<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera is the main feature, but not required: gallery import must still work without it. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Postmark only needs city + country, so coarse location is enough (optional, asked once). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- "Save to Photos" on Android 8–9 only; from Android 10 MediaStore needs no permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Streak reminder (optional, off until turned on in Profile): the note itself (Android 13+)
         and re-arming its alarm after a reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".StampApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StampApp">
        <!-- Portrait only until a landscape/tablet layout exists (milestone 4). Android 16+
             ignores this on large screens, so that layout is still needed before tablets. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"
            android:theme="@style/Theme.StampApp.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Firebase (crash reports + anonymous usage counts). Off until UsageStats has read the Profile
             switch at start; never the advertising ID or other ad signals (counting only, never ads). -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_ssaid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_storage"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_user_data"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />

        <!-- AdMob app ID (test ID in debug; see app/build.gradle.kts). Rewarded ads only. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- Shares exported stamp PNGs with other apps (read-only, per-share grant). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Lets Google Play services install the system photo picker on older Android versions
             (gallery import); without it PickVisualMedia falls back to the document picker. -->
        <service
            android:name="com.google.android.gms.metadata.ModuleDependencies"
            android:enabled="false"
            android:exported="false"
            tools:ignore="MissingClass">
            <intent-filter>
                <action android:name="com.google.android.gms.metadata.MODULE_DEPENDENCIES" />
            </intent-filter>
            <meta-data
                android:name="photopicker_activity:0:required"
                android:value="" />
        </service>
        <!-- Home-screen widgets (Glance). Each draws one picture; see widget/WidgetArt.kt. -->
        <receiver
            android:name=".widget.StampOfDayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name_stamp">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_stamp" />
        </receiver>
        <receiver
            android:name=".widget.EnvelopeWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name_envelope">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_envelope" />
        </receiver>
        <receiver
            android:name=".widget.AlbumStripWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name_strip">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_strip" />
        </receiver>
        <!-- Midnight redraw (our own alarm only). -->
        <receiver
            android:name=".widget.MidnightReceiver"
            android:exported="false" />
        <!-- Streak reminder: our alarm, and the system events that need it re-armed. -->
        <receiver
            android:name=".data.reminder.ReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".data.reminder.ReminderRearmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
